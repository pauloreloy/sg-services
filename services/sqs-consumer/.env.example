# Copy this file to `.env` and adjust as needed for local development.
# When running via `docker-compose up`, these values are already provided as
# container environment variables in docker-compose.yml (AWS_ENDPOINT_URL
# points to the "localstack" service name instead of localhost).

# --- AWS generic ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# LocalStack endpoint (started via `docker-compose up localstack`).
# Leave empty/unset to talk to real AWS.
AWS_ENDPOINT_URL=http://localhost:4566

# --- SQS ---
SQS_SOURCE_QUEUE_NAME=sg-share-queue
SQS_SUCCESS_QUEUE_NAME=sg-share-success-queue
SQS_FAILURE_QUEUE_NAME=sg-share-failure-queue
SQS_WAIT_TIME_SECONDS=10
SQS_MAX_MESSAGES=10
SQS_VISIBILITY_TIMEOUT=30
SQS_POLL_INTERVAL_SECONDS=1.0

# --- DynamoDB ---
DYNAMODB_TABLE_NAME=sg-share-processing-records

# --- App ---
APP_NAME=sharegrant-sqs-consumer
LOG_LEVEL=INFO
